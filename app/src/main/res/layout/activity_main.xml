<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_background"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAVE PC"
        android:textColor="@color/accent_neon"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BETA TESTE"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:letterSpacing="0.3"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnGameLibrary"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_button_purple"
        android:text="Biblioteca de Jogos"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btnControlsEditor"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_button_purple"
        android:text="Editor de Controles (Overlay)"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btnPhysicalController"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_button_purple"
        android:text="Verificar Controles Físicos"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:stateListAnimator="@null"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nota: O Wave PC oferece uma interface de painel e sobreposição visual. O funcionamento de comandos em jogos externos depende do suporte nativo do jogo ou do Android."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="8dp"/>

</LinearLayout>
